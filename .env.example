# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_3_PRO_MODEL=gemini-3-pro-preview
GEMINI_FLASH_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-005
GEMINI_THINKING_LEVEL=high
GEMINI_MEDIA_RESOLUTION=high

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinel_vision
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=change_this_password

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=frame_embeddings
QDRANT_VECTOR_DIM=768

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Application Configuration
APP_NAME=Sentinel Vision Phase 2
APP_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# Video Processing Configuration
MAX_CAMERAS=32
FRAME_EXTRACTION_FPS=1
MOTION_DETECTION_FPS=5
FRAME_BUFFER_SIZE=300
VIDEO_STORAGE_PATH=/data/videos
FRAME_STORAGE_PATH=/data/frames
THUMBNAIL_STORAGE_PATH=/data/thumbnails

# Person Tracking Configuration
TRACK_TTL_SECONDS=300
TRACK_CONFIDENCE_THRESHOLD=0.60
APPEARANCE_MATCH_THRESHOLD=0.65

# Threat Detection Configuration
ALERT_HIGH_SEVERITY_THRESHOLD=0.75
ALERT_MEDIUM_SEVERITY_THRESHOLD=0.60
CUSTOM_SIGNATURE_ENABLED=true

# Search Configuration
SEARCH_DEFAULT_LIMIT=20
SEARCH_CANDIDATE_MULTIPLIER=3
SEARCH_MIN_CONFIDENCE=0.40

# Performance Configuration
WORKER_PROCESSES=4
MAX_CONCURRENT_FRAMES=50
API_REQUEST_TIMEOUT=30
DATABASE_POOL_SIZE=20
REDIS_CONNECTION_POOL_SIZE=10

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# JWT Configuration (for future authentication)
JWT_SECRET_KEY=change_this_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
